# ---------------------------------------------------------------------------
# KitaFlux environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Postgres connection string. Local docker, or a Neon/Supabase pooled URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kitaflux?schema=public"
# Optional: direct (non-pooled) URL used by `prisma migrate` on Neon.
# SHADOW_DATABASE_URL=""

# --- Auth (required) -------------------------------------------------------
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Client IP for auth rate limiting (production) -------------------------
# Rate limits are keyed by client IP, so it must come from a header clients
# cannot forge. On Vercel this is detected automatically; leave both empty.
# Elsewhere set exactly one approach (see src/server/client-ip.ts):
#   CLIENT_IP_HEADER  a header your edge sets itself, e.g. "cf-connecting-ip"
#   TRUSTED_PROXIES   your reverse proxies' IPs/CIDRs, e.g. "10.0.0.0/8,192.0.2.10"
# A malformed TRUSTED_PROXIES entry stops the app at startup on purpose.
CLIENT_IP_HEADER=""
TRUSTED_PROXIES=""

# --- Content Security Policy ------------------------------------------------
# "report-only" turns CSP blocks into console warnings without a code change.
# Use it only to diagnose a breakage, then remove it. Anything else enforces.
CSP_MODE=""

# --- Email (optional; invoices + reminders are no-ops without it) ----------
# https://resend.com/api-keys
RESEND_API_KEY=""
# Must be a domain verified in Resend.
EMAIL_FROM="KitaFlux <invoices@yourdomain.com>"
# When set, every outbound email is redirected here instead of the client.
EMAIL_DEV_REDIRECT_TO=""

# --- Foreign exchange ------------------------------------------------------
# Provider: "frankfurter" (default, keyless, ECB reference rates)
#           "exchangerate.host" (requires access key)
FX_PROVIDER="frankfurter"
EXCHANGERATE_HOST_ACCESS_KEY=""

# --- Inngest (optional; scheduled overdue reminders) -----------------------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Sentry (optional) -----------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
